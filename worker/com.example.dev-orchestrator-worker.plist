<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>com.example.dev-orchestrator-worker</string>
<key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>/private/path/to/worker.py</string><string>--config</string><string>/private/path/to/config.json</string></array>
<key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
<key>StandardOutPath</key><string>/private/path/to/worker.out.log</string>
<key>StandardErrorPath</key><string>/private/path/to/worker.err.log</string>
</dict></plist>
